# Application runtime environment. Allowed values: development, test, production.
FINANCIAL_RISK_AGENT_APP_ENV = development

# SQLite path for locally durable task state. Runtime data is ignored by Git.
FINANCIAL_RISK_AGENT_DATABASE_PATH=var/runtime/financial_risk_agent.sqlite3

# LLM settings are intentionally blank. They become required only when an LLM-backed
# feature is enabled in a later development phase.
FINANCIAL_RISK_AGENT_LLM_BASE_URL = ""
FINANCIAL_RISK_AGENT_LLM_API_KEY = ""
FINANCIAL_RISK_AGENT_LLM_MODEL = "qwen3.7-max"
